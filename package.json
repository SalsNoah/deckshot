{
  "name": "deckshot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "sim": "tsx scripts/simulate.ts",
    "portraits:anim": "tsx scripts/gen-portrait-anims.ts",
    "signatures:neon": "tsx scripts/process-signatures.ts",
    "cap:sync": "vite build && cap sync"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
